# Variables de entorno para tests
# Copiar a .env durante desarrollo si es necesario

# Base de datos (SQLite en memoria para tests)
DATABASE_URL=sqlite:///:memory:

# Seguridad
SECRET_KEY=test-secret-key-muy-larga-para-tests
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Mercado Pago (dummy para tests)
MP_ACCESS_TOKEN=TEST_MP_TOKEN
MP_PUBLIC_KEY=TEST_MP_PUBLIC_KEY

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# APIs
GEMINI_API_KEY=TEST_GEMINI_KEY

# Admin
llave_maestra=test-emergency-key
llave_de_emergencia=test-emergency-key
